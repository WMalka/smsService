{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sms": "Data Source=sms.db"
  },
  "Seed": {
    "EmployeesFile": "seed/employees.json"
  },
  "SmsProvider": {
    "BaseUrl": "http://localhost:5005",
    "SendPath": "/send",
    "StatusPath": "/status/{providerId}",
    "TimeoutSeconds": 10
  },
  "Dispatcher": {
    "IntervalSeconds": 2,
    "BatchSize": 50,
    "MaxParallelSends": 10,
    "LockSeconds": 60,
    "MaxAttempts": 3,
    "FirstRetryDelaySeconds": 2,
    "DeliveryCheckSeconds": 10,
    "DeliveryTrackingHours": 24
  }
}
